<?xml version="1.0" encoding="utf-8"?>
<!-- Most IPTV servers only speak plain HTTP, so cleartext must stay allowed for stream hosts.
     The portal itself should always be https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
